import os
import time
from typing import Optional
import requests
from fastapi import FastAPI, Header, HTTPException
from fastapi.middleware.cors import CORSMiddleware
from pydantic import BaseModel

app = FastAPI(title="OiiO Bot Core Engine", version="1.2.0")

# 1. อนุญาตให้หน้าเว็บ Bolt.host และ Manus.space เรียกใช้งานได้ (CORS)
origins = [
    "https://oiio-bot.bolt.host",
    "https://oiiobot-dxjhgjyu.manus.space",
    "http://localhost",
    "http://localhost:3000",
    "http://localhost:5173",
]

app.add_middleware(
    CORSMiddleware,
    allow_origins=origins,
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

# 2. ระบบเก็บ API Key และ Token Credits เบื้องต้น
API_KEY_CREDITS = {
    "sk-oiio-demo": 10000,
}

MASTER_OIIO_KEY = os.getenv("OIIO_API_KEY", "sk-oiio-demo")
if MASTER_OIIO_KEY not in API_KEY_CREDITS:
    API_KEY_CREDITS[MASTER_OIIO_KEY] = 10000


class ChatCompletionRequest(BaseModel):
    prompt: str
    model: str = "oiio-master"
    provider_api_key: Optional[str] = None


class ChatCompletionResponse(BaseModel):
    status: str
    model: str
    researcher_output: str
    builder_output: str
    reviewer_output: str
    final_answer: str
    credits_used: int
    credits_remaining: int
    latency_ms: int


def verify_bearer_token(authorization: Optional[str]) -> str:
    if not authorization or not authorization.startswith("Bearer "):
        raise HTTPException(status_code=401, detail="Missing Bearer sk-oiio-... token")
    token = authorization.replace("Bearer ", "", 1).strip()
    if not token.startswith("sk-oiio-") or token not in API_KEY_CREDITS:
        raise HTTPException(status_code=401, detail="Invalid OiiO API Key")
    return token


def call_gemini(system_role: str, user_text: str, api_key: str) -> str:
    if not api_key:
        return f"[{system_role}] (โหมดจำลอง - กรุณาใส่ GEMINI_API_KEY): วิเคราะห์ข้อมูลสำหรับ '{user_text}' เรียบร้อยแล้ว"
    
    url = f"https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent?key={api_key}"
    payload = {
        "contents": [{
            "parts": [{"text": f"บทบาทของคุณคือ: {system_role}\n\nคำสั่งงาน: {user_text}"}]
        }]
    }
    try:
        res = requests.post(url, json=payload, timeout=30)
        res.raise_for_status()
        data = res.json()
        return data["candidates"][0]["content"]["parts"][0]["text"]
    except Exception as e:
        return f"[{system_role}] เกิดข้อผิดพลาดในการเรียก AI: {str(e)}"


