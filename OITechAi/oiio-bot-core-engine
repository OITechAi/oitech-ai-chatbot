# 4. Endpoint หลักสำหรับรันทีม Agent (@Researcher -> @Builder -> @Reviewer)
@app.post("/v1/chat/completions", response_model=ChatCompletionResponse)
async def chat_completions(
    payload: ChatCompletionRequest,
    authorization: Optional[str] = Header(default=None),
):
    start_time = time.time()
    api_key = verify_bearer_token(authorization)

    current_credits = API_KEY_CREDITS.get(api_key, 0)
    if current_credits <= 0:
        raise HTTPException(status_code=402, detail="Insufficient Token Credits")

    # ดึง Gemini API Key จากที่ส่งมาจากหน้าเว็บ หรือจาก Environment Variable บน Render
    gemini_key = payload.provider_api_key or os.getenv("GEMINI_API_KEY", "")

    # ขั้นที่ 1: @Researcher หาข้อมูล
    researcher_out = call_gemini(
        "@Researcher ผู้เชี่ยวชาญการวิเคราะห์ข้อมูลและประเมินความเสี่ยง สรุปประเด็นสำคัญอย่างกระชับ",
        payload.prompt,
        gemini_key
    )

    # ขั้นที่ 2: @Builder วางโครงสร้าง/ลงมือทำ
    builder_out = call_gemini(
        "@Builder สถาปนิกและนักพัฒนา ออกแบบโครงสร้าง แผนงาน หรือเขียนโค้ดจากข้อมูลนี้",
        f"โจทย์หลัก: {payload.prompt}\nข้อมูลจาก Researcher: {researcher_out}",
        gemini_key
    )

    # ขั้นที่ 3: @Reviewer ตรวจสอบคุณภาพและสรุปผล
    reviewer_out = call_gemini(
        "@Reviewer ผู้ตรวจสอบคุณภาพ ตรวจหาจุดบกพร่องและสรุปคำตอบสุดท้ายที่สมบูรณ์พร้อมใช้งาน",
        f"โจทย์หลัก: {payload.prompt}\nผลงานจาก Builder: {builder_out}",
        gemini_key
    )

    # คำนวณและหัก Token Credit
    total_chars = len(payload.prompt) + len(researcher_out) + len(builder_out) + len(reviewer_out)
    credits_used = max(30, total_chars // 50)

    if current_credits < credits_used:
        raise HTTPException(status_code=402, detail="Not enough credits for this task")

    API_KEY_CREDITS[api_key] = current_credits - credits_used
    latency_ms = int((time.time() - start_time) * 1000)

    return ChatCompletionResponse(
        status="success",
        model=payload.model,
        researcher_output=researcher_out,
        builder_output=builder_out,
        reviewer_output=reviewer_out,
        final_answer=reviewer_out,
        credits_used=credits_used,
        credits_remaining=API_KEY_CREDITS[api_key],
        latency_ms=latency_ms,
    )
